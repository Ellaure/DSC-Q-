{$R *.dfm}

function gausspeak(f, f0, c: Double): Double;
begin
  Result := Exp(-Sqr(f - f0) / (2 * Sqr(c))) / Sqrt(2 * Pi * Sqr(c));
end;

function addscaled(const s, k: tstate; h: Double): tstate;
begin
  Result.x := s.x + h * k.x;
  Result.y := s.y + h * k.y;
  Result.z := s.z + h * k.z;
end;

procedure TForm1.FormCreate(Sender: TObject);
begin
  FormatSettings.DecimalSeparator := '.';
end;

function TForm1.readparam(index: Integer): Double;
begin
  Result := StrToFloat((FindComponent('Edit' + IntToStr(index)) as TEdit).Text);
end;

function TForm1.angularfreq(t: Double): Double;
var
  idx: Integer;
begin
  idx := Trunc(t / dt);

  if idx < 0 then
    idx := 0;

  if idx > High(rrdat) then
    idx := High(rrdat);

  if rrdat[idx] <= 0 then
    raise Exception.Create('RR interval harus positif');

  Result := 2 * Pi / rrdat[idx];
end;

function TForm1.deriv(t: Double; const s: tstate): tstate;
var
  radial, omega, sudut, delta, sum, zbase: Double;
  j: Integer;
begin
  radial := 1.0 - Sqrt(s.x * s.x + s.y * s.y);
  omega := angularfreq(t);

  Result.x := radial * s.x - omega * s.y;
  Result.y := radial * s.y + omega * s.x;

  zbase := 0.005 * Sin(2 * Pi * t);
  sudut := ArcTan2(s.y, s.x);
  sum := 0;

  for j := 1 to 6 do
  begin
    delta := ArcTan2(Sin(sudut - theta[j]), Cos(sudut - theta[j]));
    sum := sum - amp[j] * delta * Exp(-0.5 * Sqr(delta) / Sqr(wid[j]));
  end;

  Result.z := sum - (s.z - zbase);
end;

procedure TForm1.stepeuler(var s: tstate; t: Double);
begin
  s := addscaled(s, deriv(t, s), dt);
end;

procedure TForm1.steprk2(var s: tstate; t: Double);
var
  k1, k2: tstate;
begin
  k1 := deriv(t, s);
  k2 := deriv(t + dt * 0.5, addscaled(s, k1, dt * 0.5));

  s := addscaled(s, k2, dt);
end;

procedure TForm1.steprk4(var s: tstate; t: Double);
var
  k1, k2, k3, k4: tstate;
begin
  k1 := deriv(t, s);
  k2 := deriv(t + dt * 0.5, addscaled(s, k1, dt * 0.5));
  k3 := deriv(t + dt * 0.5, addscaled(s, k2, dt * 0.5));
  k4 := deriv(t + dt, addscaled(s, k3, dt));

  s.x := s.x + (dt / 6) * (k1.x + 2 * k2.x + 2 * k3.x + k4.x);
  s.y := s.y + (dt / 6) * (k1.y + 2 * k2.y + 2 * k3.y + k4.y);
  s.z := s.z + (dt / 6) * (k1.z + 2 * k2.z + 2 * k3.z + k4.z);
end;

procedure TForm1.steprk8(var s: tstate; t: Double);
var
  a: array[1..13, 1..13] of Double;
  b: array[1..13] of Double;
  k: array[1..13] of tstate;
  st, j: Integer;
  p, sum: tstate;
  c: Double;
begin
  FillChar(a, SizeOf(a), 0);
  FillChar(b, SizeOf(b), 0);

  a[2, 1] := 2 / 27;

  a[3, 1] := 1 / 36;
  a[3, 2] := 1 / 12;

  a[4, 1] := 1 / 24;
  a[4, 3] := 1 / 8;

  a[5, 1] := 5 / 12;
  a[5, 3] := -25 / 16;
  a[5, 4] := 25 / 16;

  a[6, 1] := 1 / 20;
  a[6, 4] := 1 / 4;
  a[6, 5] := 1 / 5;

  a[7, 1] := -25 / 108;
  a[7, 4] := 125 / 108;
  a[7, 5] := -65 / 27;
  a[7, 6] := 125 / 54;

  a[8, 1] := 31 / 300;
  a[8, 5] := 61 / 225;
  a[8, 6] := -2 / 9;
  a[8, 7] := 13 / 900;

  a[9, 1] := 2;
  a[9, 4] := -53 / 6;
  a[9, 5] := 704 / 45;
  a[9, 6] := -107 / 9;
  a[9, 7] := 67 / 90;
  a[9, 8] := 3;

  a[10, 1] := -91 / 108;
  a[10, 4] := 23 / 108;
  a[10, 5] := -976 / 135;
  a[10, 6] := 311 / 54;
  a[10, 7] := -19 / 60;
  a[10, 8] := 17 / 6;
  a[10, 9] := -1 / 12;

  a[11, 1] := 2383 / 4100;
  a[11, 4] := -341 / 164;
  a[11, 5] := 4496 / 1025;
  a[11, 6] := -301 / 82;
  a[11, 7] := 2133 / 4100;
  a[11, 8] := 45 / 82;
  a[11, 9] := 45 / 164;
  a[11, 10] := 18 / 41;

  a[12, 1] := 3 / 205;
  a[12, 6] := -6 / 41;
  a[12, 7] := -3 / 205;
  a[12, 8] := -3 / 41;
  a[12, 9] := 3 / 41;
  a[12, 10] := 6 / 41;

  a[13, 1] := -1777 / 4100;
  a[13, 4] := -341 / 164;
  a[13, 5] := 4496 / 1025;
  a[13, 6] := -289 / 82;
  a[13, 7] := 2193 / 4100;
  a[13, 8] := 51 / 82;
  a[13, 9] := 33 / 164;
  a[13, 10] := 12 / 41;
  a[13, 12] := 1;

  // Bobot solusi orde 8
  b[6] := 34 / 105;
  b[7] := 9 / 35;
  b[8] := 9 / 35;
  b[9] := 9 / 280;
  b[10] := 9 / 280;
  b[12] := 41 / 840;
  b[13] := 41 / 840;

  for st := 1 to 13 do
  begin
    p := s;
    c := 0;

    for j := 1 to st - 1 do
    begin
      c := c + a[st, j];
      p := addscaled(p, k[j], dt * a[st, j]);
    end;

    k[st] := deriv(t + dt * c, p);
  end;

  sum.x := 0;
  sum.y := 0;
  sum.z := 0;

  for st := 1 to 13 do
  begin
    sum.x := sum.x + b[st] * k[st].x;
    sum.y := sum.y + b[st] * k[st].y;
    sum.z := sum.z + b[st] * k[st].z;
  end;

  s := addscaled(s, sum, dt);
end;

procedure TForm1.Button1Click(Sender: TObject);
var
  i, k, n: Integer;
  f1, f2, c1, c2, ratio, hmean, fvlf, cvlf, avlf: Double;
  freq, magsf, phase, angle, sumre, sumim: Double;
  rrmean, rrscale, noiselevel: Double;
  spec, root, respec, imspec, tacho: array of Double;
begin
  f1 := StrToFloat(Edit1.Text);
  f2 := StrToFloat(Edit2.Text);
  c1 := StrToFloat(Edit3.Text);
  c2 := StrToFloat(Edit4.Text);
  ratio := StrToFloat(Edit5.Text);
  n := StrToInt(Edit6.Text);
  hmean := StrToFloat(Edit7.Text);
  fvlf := StrToFloat(Edit27.Text);
  cvlf := StrToFloat(Edit28.Text);
  avlf := StrToFloat(Edit29.Text);
  rrscale := StrToFloat(Edit10.Text);
  noiselevel := StrToFloat(Edit30.Text);

  if (n < 2) or (c1 <= 0) or (c2 <= 0) or (cvlf <= 0) or (noiselevel < 0) then
  begin
    ShowMessage('Periksa parameter Gaussian!');
    Exit;
  end;

  if hmean <= 0 then
  begin
    ShowMessage('Heart rate harus lebih dari 0!');
    Exit;
  end;

  SetLength(spec, n);
  SetLength(root, n);
  SetLength(respec, n);
  SetLength(imspec, n);
  SetLength(tacho, n);

  Series1.Clear;
  Series2.Clear;
  Series3.Clear;
  Series4.Clear;
  Series5.Clear;
  Series6.Clear;

  Randomize;

  magsf := 1.7 / n;

  // Gaussian LF + HF + VLF + white noise
  for i := 0 to n - 1 do
  begin
    freq := i / n;

    spec[i] := magsf * (ratio * gausspeak(freq, f1, c1)
      + gausspeak(freq, f2, c2)
      + avlf * gausspeak(freq, fvlf, cvlf))
      + noiselevel * Random;

    Series1.AddXY(freq, spec[i]);
  end;

  //sqrt dan mirror
  for i := 0 to n - 1 do
  begin
    if i < n div 2 then
      root[i] := Sqrt(spec[i])
    else
      root[i] := Sqrt(spec[n - i]);

    Series2.AddXY(i / n, root[i]);
  end;

  //fase acak
  for i := 0 to n - 1 do
  begin
    phase := 2 * Pi * Random;

    respec[i] := root[i] * Cos(phase);
    imspec[i] := root[i] * Sin(phase);

    Series3.AddXY(i / n, respec[i]);
    Series4.AddXY(i / n, imspec[i]);
  end;

  //IDFT
  for i := 0 to n - 1 do
  begin
    sumre := 0;
    sumim := 0;

    for k := 0 to n - 1 do
    begin
      angle := 2 * Pi * k * i / n;

      sumre := sumre + respec[k] * Cos(angle);
      sumim := sumim + imspec[k] * Sin(angle);
    end;

    tacho[i] := (sumre + sumim) / n;

    Series5.AddXY(i, tacho[i]);
  end;

  //RR tachogram
  rrmean := 60 / hmean;
  Edit9.Text := FloatToStr(rrmean);

  SetLength(rrdat, n);

  for i := 0 to n - 1 do
  begin
    rrdat[i] := rrmean + tacho[i] * rrscale;

    Series6.AddXY(i, rrdat[i]);
  end;
end;

procedure TForm1.Button2Click(Sender: TObject);
var
  i, fecg, method: Integer;
  hmean, hrfact, hrfact2, clock: Double;
  s: tstate;
begin
  if Length(rrdat) = 0 then
  begin
    ShowMessage('Jalankan Step 1 terlebih dahulu!');
    Exit;
  end;

  method := ComboBox1.ItemIndex;

  if not (method in [0..3]) then
  begin
    ShowMessage('Pilih Metode Integrasi');
    Exit;
  end;

  fecg := StrToInt(Edit11.Text);
  hmean := StrToFloat(Edit7.Text);

  if (fecg <= 0) or (hmean <= 0) then
  begin
    ShowMessage('Periksa frekuensi ECG dan heart rate!');
    Exit;
  end;

  dt := 1.0 / fecg;

  for i := 1 to 5 do
  begin
    theta[i] := readparam(11 + i) * Pi / 180;
    amp[i] := readparam(16 + i);
    wid[i] := readparam(21 + i);
  end;

  theta[6] := StrToFloat(Edit31.Text) * Pi / 180;
  amp[6] := StrToFloat(Edit33.Text);
  wid[6] := StrToFloat(Edit34.Text);

  for i := 1 to 6 do
  begin
    if wid[i] <= 0 then
    begin
      ShowMessage('Lebar PQRST harus positif!');
      Exit;
    end;
  end;

  if CheckBox1.Checked then
    hrfact := Sqrt(hmean / 60)
  else
    hrfact := 1;

  hrfact2 := Sqrt(hrfact);

  Edit32.Text := FloatToStrF(hrfact, ffFixed, 8, 3);

  theta[1] := theta[1] * hrfact2;
  theta[2] := theta[2] * hrfact;
  theta[4] := theta[4] * hrfact;
  theta[5] := theta[5] * hrfact2;
  theta[6] := theta[6] * hrfact2;

  amp[5] := amp[5] * Power(hrfact, 2.5);
  amp[6] := amp[6] * Power(hrfact, 2.5);

  wid[1] := wid[1] * hrfact;
  wid[2] := wid[2] * hrfact;
  wid[3] := wid[3] * hrfact;
  wid[4] := wid[4] * hrfact;
  wid[5] := wid[5] * hrfact;
  wid[6] := wid[6] / hrfact;

  Series7.Clear;

  s.x := 0.1;
  s.y := 0.0;
  s.z := 0.04;
  clock := 0.0;

  for i := 0 to High(rrdat) do
  begin
    case method of
      0: stepeuler(s, clock);
      1: steprk2(s, clock);
      2: steprk4(s, clock);
    else
      steprk8(s, clock);
    end;

    clock := clock + dt;

    Series7.AddXY(clock, s.z);
  end;

  Chart5.BottomAxis.Automatic := True;
  Chart5.LeftAxis.Automatic := True;
end;

