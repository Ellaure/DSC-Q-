function TForm2.sigmoid(X: Double): Double;
begin
  if x < -45.0 then
    Result := 0.0
  else
    Result := 1.0 / (1.0 + Exp(-x));
end;

// turunan sigmoid; Output = hasil sigmoid
function TForm2.sigder(Output: Double): Double;
begin
  Result := Output * (1.0 - Output);
end;

// Teaching signal dari aturan soal. Indeks kelas = nomor region (0 = normal).
function TForm2.ruleclass(r, q: Real): Integer;
begin
  if r < 0.32 then Result := 1                 // Region 1
  else if r >= 1.66 then Result := 6           // Region 6
  else if r > 1.2 then Result := 5             // Region 5
  else if r < 0.6 then
  begin
    if q <= 100 then Result := 2 else Result := 3;   // Region 2 / 3
  end
  else
  begin
    if q <= 100 then Result := 0 else Result := 4;   // Normal / Region 4
  end;
end;

// Cari file di folder kerja, folder exe, lalu dialog
function TForm2.findfile(const defname: string; out fpath: string): Boolean;
begin
  fpath := defname;
  if FileExists(fpath) then
  begin
    Result := True;
    Exit;
  end;
  fpath := TPath.Combine(ExtractFilePath(ParamStr(0)), defname);
  if FileExists(fpath) then
  begin
    Result := True;
    Exit;
  end;
  OpenDialog1.Title := 'Pilih file ' + defname;
  OpenDialog1.Filter := 'Data file (*.dat)|*.dat|All files (*.*)|*.*';
  OpenDialog1.FileName := defname;
  Result := OpenDialog1.Execute;
  if Result then fpath := OpenDialog1.FileName;
end;

// Baca file: baris pertama dilewati (header), kolom = no, RR, QRSd
function TForm2.loadbeats(const fname: string; out idx, r, q: TArray<Real>): Integer;
var
  lines, sl: TStringList;
  i, n: Integer;
  fs: TFormatSettings;
begin
  fs := TFormatSettings.Create;
  fs.DecimalSeparator := '.';
  lines := TStringList.Create;
  sl := TStringList.Create;
  try
    lines.LoadFromFile(fname);
    sl.Delimiter := ' ';
    sl.StrictDelimiter := False;
    SetLength(idx, lines.Count);
    SetLength(r, lines.Count);
    SetLength(q, lines.Count);
    n := 0;
    for i := 1 to lines.Count - 1 do
    begin
      if Trim(lines[i]) = '' then Continue;
      sl.DelimitedText := lines[i];
      if sl.Count >= 3 then
      begin
        try
          idx[n] := StrToInt(Trim(sl[0]));
          r[n] := StrToFloat(Trim(sl[1]), fs);
          q[n] := StrToFloat(Trim(sl[2]), fs);
          Inc(n);
        except
          on E: EConvertError do Continue;   // lewati baris rusak
        end;
      end;
    end;
    SetLength(idx, n);
    SetLength(r, n);
    SetLength(q, n);
    Result := n;
  finally
    sl.Free;
    lines.Free;
  end;
end;

procedure TForm2.fwd(const x: TArray<Real>; var h1a, h2a, h3a, outa: TArray<Real>);
var
  j, k: Integer;
  s: Real;
begin
  for j := 0 to nh1 - 1 do
  begin
    s := b1[j];
    for k := 0 to nin - 1 do s := s + x[k] * w1[k, j];
    h1a[j] := sigmoid(s);
  end;
  for j := 0 to nh2 - 1 do
  begin
    s := b2[j];
    for k := 0 to nh1 - 1 do s := s + h1a[k] * w2[k, j];
    h2a[j] := sigmoid(s);
  end;
  for j := 0 to nh3 - 1 do
  begin
    s := b3[j];
    for k := 0 to nh2 - 1 do s := s + h2a[k] * w3[k, j];
    h3a[j] := sigmoid(s);
  end;
  for j := 0 to nout - 1 do
  begin
    s := b4[j];
    for k := 0 to nh3 - 1 do s := s + h3a[k] * w4[k, j];
    outa[j] := sigmoid(s);
  end;
end;

procedure TForm2.savehist(const w: TArray<TArray<Real>>; var hist: TArray<TArray<Real>>; idx: Integer);
var
  i, j, widx: Integer;
begin
  SetLength(hist, idx + 1);
  SetLength(hist[idx], Length(w) * Length(w[0]));
  widx := 0;
  for i := 0 to High(w) do
    for j := 0 to High(w[i]) do
    begin
      hist[idx, widx] := w[i, j];
      Inc(widx);
    end;
end;

procedure TForm2.Button1Click(Sender: TObject);
var
  i, j, n: Integer;
  spath: string;
begin
  if not findfile(trainfile, spath) then
  begin
    ShowMessage('Peringatan: File "' + trainfile + '" tidak ditemukan.');
    Exit;
  end;

  n := loadbeats(spath, idxtr, rrtr, qrstr);
  Edit1.Text := IntToStr(n);
  ndata := n;
  if ndata = 0 then
  begin
    ShowMessage('Tidak ada data yang dapat dibaca dari file ' + spath);
    Exit;
  end;

  SetLength(trdat, ndata, 2);
  for i := 0 to ndata - 1 do
  begin
    trdat[i, 0] := rrtr[i];
    trdat[i, 1] := qrstr[i];
  end;

  // min / max training, lalu normalisasi min-max
  minrr := trdat[0, 0]; maxrr := trdat[0, 0];
  minqrs := trdat[0, 1]; maxqrs := trdat[0, 1];
  for i := 1 to ndata - 1 do
  begin
    if trdat[i, 0] < minrr then minrr := trdat[i, 0];
    if trdat[i, 0] > maxrr then maxrr := trdat[i, 0];
    if trdat[i, 1] < minqrs then minqrs := trdat[i, 1];
    if trdat[i, 1] > maxqrs then maxqrs := trdat[i, 1];
  end;
  for i := 0 to ndata - 1 do
  begin
    if (maxrr - minrr) <> 0 then
      trdat[i, 0] := (trdat[i, 0] - minrr) / (maxrr - minrr)
    else
      trdat[i, 0] := 0;
    if (maxqrs - minqrs) <> 0 then
      trdat[i, 1] := (trdat[i, 1] - minqrs) / (maxqrs - minqrs)
    else
      trdat[i, 1] := 0;
  end;

  Series1.Clear;
  for i := 0 to ndata - 1 do
    Series1.AddXY(trdat[i, 0], trdat[i, 1]);

  // teaching signal one-hot (7 region)
  SetLength(labdat, ndata, 7);
  for i := 0 to ndata - 1 do
  begin
    for j := 0 to 6 do labdat[i, j] := 0;
    labdat[i, ruleclass(rrtr[i], qrstr[i])] := 1.0;
  end;
end;

procedure TForm2.Button2Click(Sender: TObject);
var
  epoch, d, dd, tmp, rnd, j, k, i, totit, histidx: Integer;
  errsum, errsig, updw, updb: Real;
  h1a, h2a, h3a, outa, dout, d3, d2, d1: TArray<Real>;
  pw1, pw2, pw3, pw4: TArray<TArray<Real>>;   // update bobot sebelumnya (momentum)
  pb1, pb2, pb3, pb4: TArray<Real>;
  ncorrect, nwrong, predcls, truecls: Integer;
  maxval: Real;
  shufidx: TArray<Integer>;
  reachedmax: Boolean;
begin
  if (ndata = 0) or (Length(trdat) = 0) then
  begin
    ShowMessage('Data training belum dimuat.');
    Exit;
  end;

  getdata;
  random;

  maxepoch := maxepochdef;
  reachedmax := False;
  stoptrain := False;
  Button2.Enabled := False;
  Button3.Enabled := True;
  ListBox1.Clear; ListBox3.Clear; ListBox4.Clear;
  ListBox5.Clear; ListBox6.Clear; ListBox7.Clear;
  Series2.Clear;
  Series2.Title := 'MSE per Epoch';
  Chart2.BottomAxis.Title.Caption := 'Epoch';

  epoch := 0;
  totit := 0;
  histidx := -1;

  SetLength(shufidx, ndata);
  for i := 0 to ndata - 1 do shufidx[i] := i;

  SetLength(h1a, nh1); SetLength(h2a, nh2); SetLength(h3a, nh3);
  SetLength(outa, nout);
  SetLength(d1, nh1); SetLength(d2, nh2); SetLength(d3, nh3);
  SetLength(dout, nout);
  SetLength(pw1, nin, nh1); SetLength(pw2, nh1, nh2);
  SetLength(pw3, nh2, nh3); SetLength(pw4, nh3, nout);
  SetLength(pb1, nh1); SetLength(pb2, nh2);
  SetLength(pb3, nh3); SetLength(pb4, nout);
  SetLength(mseall, 0);
  SetLength(w1hist, 0); SetLength(w2hist, 0);
  SetLength(w3hist, 0); SetLength(w4hist, 0);

  while not stoptrain do
  begin
    Inc(epoch);
    errsum := 0.0;

    // acak urutan data tiap epoch (Fisher-Yates)
    for i := ndata - 1 downto 1 do
    begin
      rnd := System.Random(i + 1);
      tmp := shufidx[i]; shufidx[i] := shufidx[rnd]; shufidx[rnd] := tmp;
    end;

    for dd := 0 to ndata - 1 do
    begin
      d := shufidx[dd];
      Inc(totit);

      fwd(trdat[d], h1a, h2a, h3a, outa);

      for k := 0 to nout - 1 do
        errsum := errsum + 0.5 * Sqr(labdat[d][k] - outa[k]);

      // delta tiap layer (backprop)
      for j := 0 to nout - 1 do
        dout[j] := (labdat[d][j] - outa[j]) * sigder(outa[j]);
      for j := 0 to nh3 - 1 do
      begin
        errsig := 0.0;
        for k := 0 to nout - 1 do errsig := errsig + dout[k] * w4[j, k];
        d3[j] := errsig * sigder(h3a[j]);
      end;
      for j := 0 to nh2 - 1 do
      begin
        errsig := 0.0;
        for k := 0 to nh3 - 1 do errsig := errsig + d3[k] * w3[j, k];
        d2[j] := errsig * sigder(h2a[j]);
      end;
      for j := 0 to nh1 - 1 do
      begin
        errsig := 0.0;
        for k := 0 to nh2 - 1 do errsig := errsig + d2[k] * w2[j, k];
        d1[j] := errsig * sigder(h1a[j]);
      end;

      // update bobot + momentum: w4 (output), w3, w2, w1
      for j := 0 to nout - 1 do
      begin
        for k := 0 to nh3 - 1 do
        begin
          updw := lr * dout[j] * h3a[k] + mom * pw4[k, j];
          w4[k, j] := w4[k, j] + updw; pw4[k, j] := updw;
        end;
        updb := lr * dout[j] + mom * pb4[j];
        b4[j] := b4[j] + updb; pb4[j] := updb;
      end;
      for j := 0 to nh3 - 1 do
      begin
        for k := 0 to nh2 - 1 do
        begin
          updw := lr * d3[j] * h2a[k] + mom * pw3[k, j];
          w3[k, j] := w3[k, j] + updw; pw3[k, j] := updw;
        end;
        updb := lr * d3[j] + mom * pb3[j];
        b3[j] := b3[j] + updb; pb3[j] := updb;
      end;
      for j := 0 to nh2 - 1 do
      begin
        for k := 0 to nh1 - 1 do
        begin
          updw := lr * d2[j] * h1a[k] + mom * pw2[k, j];
          w2[k, j] := w2[k, j] + updw; pw2[k, j] := updw;
        end;
        updb := lr * d2[j] + mom * pb2[j];
        b2[j] := b2[j] + updb; pb2[j] := updb;
      end;
      for j := 0 to nh1 - 1 do
      begin
        for k := 0 to nin - 1 do
        begin
          updw := lr * d1[j] * trdat[d][k] + mom * pw1[k, j];
          w1[k, j] := w1[k, j] + updw; pw1[k, j] := updw;
        end;
        updb := lr * d1[j] + mom * pb1[j];
        b1[j] := b1[j] + updb; pb1[j] := updb;
      end;
    end;

    // MSE epoch ini
    curmse := errsum / ndata;
    SetLength(mseall, epoch);
    mseall[epoch - 1] := curmse;

    Series2.AddXY(epoch, curmse);
    ListBox1.Items.Add(Format('Epoch: %d, Iterasi: %d, MSE: %.8f', [epoch, totit, curmse]));
    if ListBox1.Items.Count > 2000 then ListBox1.Items.Delete(0);
    ListBox1.ItemIndex := ListBox1.Items.Count - 1;
    Application.ProcessMessages;

    // catat bobot untuk grafik tiap epochstep epoch
    if (epoch mod epochstep) = 0 then
    begin
      Inc(histidx);
      savehist(w1, w1hist, histidx);
      savehist(w2, w2hist, histidx);
      savehist(w3, w3hist, histidx);
      savehist(w4, w4hist, histidx);
    end;

    if curmse < errth then
    begin
      ListBox1.Items.Add('Training selesai: Target error tercapai.');
      Break;
    end;

    if epoch >= maxepoch then
    begin
      reachedmax := True;
      Break;
    end;
  end;

  finepoch := epoch;
  if stoptrain then
    ListBox1.Items.Add(Format('Training dihentikan manual pada Epoch %d.', [epoch]));
  if reachedmax then
    ListBox1.Items.Add(Format('Training berhenti: batas maksimum epoch (%d) tercapai.', [maxepoch]));

  updcharts;

  // akurasi training: kelas dengan output terbesar vs teaching signal
  ncorrect := 0;
  for d := 0 to ndata - 1 do
  begin
    fwd(trdat[d], h1a, h2a, h3a, outa);
    maxval := -1.0; predcls := -1;
    for k := 0 to nout - 1 do
      if outa[k] > maxval then begin maxval := outa[k]; predcls := k; end;
    truecls := -1;
    for k := 0 to nout - 1 do
      if labdat[d, k] = 1.0 then begin truecls := k; Break; end;
    if predcls = truecls then Inc(ncorrect);
  end;

  finacc := (ncorrect / ndata) * 100.0;
  nwrong := ndata - ncorrect;

  ListBox1.Items.Add('--- Ringkasan Training & Akurasi ---');
  ListBox1.Items.Add(Format('Training Selesai pada Epoch: %d (Iterasi: %d)', [epoch, totit]));
  ListBox1.Items.Add(Format('MSE Terakhir: %.8f', [curmse]));
  ListBox1.Items.Add(Format('Akurasi Training: %.2f%%', [finacc]));
  ListBox1.Items.Add(Format('Prediksi Benar: %d, Salah: %d', [ncorrect, nwrong]));
  ListBox1.Items.Add('------------------------------------');

  showw;
  Button2.Enabled := True;
  Button3.Enabled := False;
end;

