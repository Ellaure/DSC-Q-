// Simpan model ke JSON
procedure TForm2.Button4Click(Sender: TObject);
var
  savdlg: TSaveDialog;
  jobj, jarch, jwts, jbias, jnorm: TJSONObject;
  jarr, jinner: TJSONArray;
  ws: array[1..4] of TArray<TArray<Real>>;
  bs: array[1..4] of TArray<Real>;
  i: Integer;
begin
  savdlg := TSaveDialog.Create(Self);
  try
    savdlg.Filter := 'JSON Model File (*.json)|*.json';
    savdlg.DefaultExt := 'json';
    if not savdlg.Execute then Exit;

    ws[1] := w1; ws[2] := w2; ws[3] := w3; ws[4] := w4;
    bs[1] := b1; bs[2] := b2; bs[3] := b3; bs[4] := b4;

    jobj := TJSONObject.Create;
    try
      jarch := TJSONObject.Create;
      jarch.AddPair('n_in', TJSONNumber.Create(nin));
      jarch.AddPair('n_hid1', TJSONNumber.Create(nh1));
      jarch.AddPair('n_hid2', TJSONNumber.Create(nh2));
      jarch.AddPair('n_hid3', TJSONNumber.Create(nh3));
      jarch.AddPair('n_out', TJSONNumber.Create(nout));
      jobj.AddPair('architecture', jarch);

      jwts := TJSONObject.Create;
      jbias := TJSONObject.Create;
      for i := 1 to 4 do
      begin
        jarr := TJSONArray.Create;
        for var row in ws[i] do
        begin
          jinner := TJSONArray.Create;
          for var val in row do jinner.Add(val);
          jarr.AddElement(jinner);
        end;
        jwts.AddPair('w' + i.ToString, jarr);

        jarr := TJSONArray.Create;
        for var val in bs[i] do jarr.Add(val);
        jbias.AddPair('b' + i.ToString, jarr);
      end;
      jobj.AddPair('weights', jwts);
      jobj.AddPair('biases', jbias);

      // min/max training, dipakai lagi saat recall
      jnorm := TJSONObject.Create;
      jnorm.AddPair('min_rr', TJSONNumber.Create(minrr));
      jnorm.AddPair('max_rr', TJSONNumber.Create(maxrr));
      jnorm.AddPair('min_qrs', TJSONNumber.Create(minqrs));
      jnorm.AddPair('max_qrs', TJSONNumber.Create(maxqrs));
      jobj.AddPair('normalization', jnorm);

      jobj.AddPair('final_epoch', TJSONNumber.Create(finepoch));
      jobj.AddPair('final_mse', TJSONNumber.Create(curmse));
      jobj.AddPair('final_accuracy', TJSONNumber.Create(finacc));
      jobj.AddPair('learning_rate', TJSONNumber.Create(lr));
      jobj.AddPair('momentum', TJSONNumber.Create(mom));

      jarr := TJSONArray.Create;
      for var mval in mseall do jarr.Add(mval);
      jobj.AddPair('mse_history', jarr);

      TFile.WriteAllText(savdlg.FileName, jobj.ToJSON);
      ShowMessage('Model berhasil disimpan ke ' + savdlg.FileName);
    finally
      jobj.Free;
    end;
  finally
    savdlg.Free;
  end;
end;

// Load data recall, dinormalisasi dengan min/max training
procedure TForm2.Button5Click(Sender: TObject);
var
  n, i: Integer;
  spath: string;
begin
  if not findfile(recfile, spath) then
  begin
    ShowMessage('Peringatan: File "' + recfile + '" tidak ditemukan.');
    Exit;
  end;

  n := loadbeats(spath, idxrec, rrrec, qrsrec);
  Edit6.Text := IntToStr(n);
  if n = 0 then
  begin
    ShowMessage('Tidak ada data recall yang dapat dibaca.');
    Exit;
  end;

  SetLength(recdat, n, 2);
  for i := 0 to n - 1 do
  begin
    if (maxrr - minrr) <> 0 then
      recdat[i, 0] := (rrrec[i] - minrr) / (maxrr - minrr)
    else
      recdat[i, 0] := 0;
    if (maxqrs - minqrs) <> 0 then
      recdat[i, 1] := (qrsrec[i] - minqrs) / (maxqrs - minqrs)
    else
      recdat[i, 1] := 0;
  end;

  Series3.Clear;
  for i := 0 to n - 1 do
    Series3.AddXY(recdat[i, 0], recdat[i, 1]);
end;

// Recall: klasifikasi tiap beat ke region, lalu baca urutannya (Bradycardia, PVC)
procedure TForm2.Button6Click(Sender: TObject);
var
  i, j, predcls, run, reccorr: Integer;
  maxval, recacc: Real;
  regionnames: array[0..6] of string;
  outstr: string;
  oh1, oh2, oh3, oout: TArray<Real>;
  predarr: TArray<Integer>;
begin
  ListBox2.Clear;
  Series4.Clear; Series5.Clear; Series6.Clear; Series7.Clear;
  Series8.Clear; Series9.Clear; Series10.Clear;

  if Length(recdat) = 0 then
  begin
    ShowMessage('Data recall belum ada. Muat data terlebih dahulu.');
    Exit;
  end;
  if Length(w1) = 0 then
  begin
    ShowMessage('Model belum dilatih atau dimuat. Lakukan training atau muat model.');
    Exit;
  end;

  SetLength(oh1, nh1); SetLength(oh2, nh2);
  SetLength(oh3, nh3); SetLength(oout, nout);
  SetLength(predarr, Length(recdat));
  regionnames[0] := 'Normal'; regionnames[1] := 'Tachycardia';
  regionnames[2] := 'R-on-T'; regionnames[3] := 'Kandidat PVC';
  regionnames[4] := 'Fusion Beat'; regionnames[5] := 'Region 5 (kandidat Bradycardia)';
  regionnames[6] := 'Dropped Beat';

  reccorr := 0;
  for i := 0 to High(recdat) do
  begin
    fwd(recdat[i], oh1, oh2, oh3, oout);

    maxval := -1.0;
    predcls := -1;
    for j := 0 to nout - 1 do
      if oout[j] > maxval then begin maxval := oout[j]; predcls := j; end;
    predarr[i] := predcls;
    if predcls = ruleclass(rrrec[i], qrsrec[i]) then Inc(reccorr);

    outstr := 'Data ke-' + IntToStr(i + 1) + ': [';
    for j := 0 to nout - 1 do
    begin
      outstr := outstr + Format('%.4f', [oout[j]]);
      if j < nout - 1 then outstr := outstr + ', ';
    end;
    ListBox2.Items.Add(outstr + ']');

    if (predcls >= 0) and (predcls <= 6) then
    begin
      ListBox2.Items.Add(Format('  -> Prediksi: %s', [regionnames[predcls]]));
      case predcls of
        0: Series4.AddXY(rrrec[i], qrsrec[i]);
        1: Series5.AddXY(rrrec[i], qrsrec[i]);
        2: Series6.AddXY(rrrec[i], qrsrec[i]);
        3: Series7.AddXY(rrrec[i], qrsrec[i]);
        4: Series8.AddXY(rrrec[i], qrsrec[i]);
        5: Series9.AddXY(rrrec[i], qrsrec[i]);
        6: Series10.AddXY(rrrec[i], qrsrec[i]);
      end;
    end
    else
      ListBox2.Items.Add('  -> Prediksi: Tidak dapat diprediksi');
    ListBox2.Items.Add('');
  end;

  // Interpretasi berurutan:
  // Bradycardia = 3 beat Region 5 berturut-turut,
  // PVC terkompensasi = Region 3 diikuti Region 5, tidak terkompensasi = diikuti normal
  ListBox2.Items.Add('--- Interpretasi Berurutan ---');
  i := 0;
  while i <= High(predarr) do
  begin
    if predarr[i] = 5 then
    begin
      run := 0;
      while (i + run <= High(predarr)) and (predarr[i + run] = 5) do Inc(run);
      if run >= 3 then
        ListBox2.Items.Add(Format('Data ke-%d s/d %d: Bradycardia', [i + 1, i + run]))
      else
        ListBox2.Items.Add(Format('Data ke-%d s/d %d: Region 5 (kurang dari 3 berurutan)', [i + 1, i + run]));
      Inc(i, run);
    end
    else
    begin
      if predarr[i] = 3 then
      begin
        if (i < High(predarr)) and (predarr[i + 1] = 5) then
          ListBox2.Items.Add(Format('Data ke-%d: PVC terkompensasi', [i + 1]))
        else if (i < High(predarr)) and (predarr[i + 1] = 0) then
          ListBox2.Items.Add(Format('Data ke-%d: PVC tidak terkompensasi', [i + 1]))
        else
          ListBox2.Items.Add(Format('Data ke-%d: Kandidat PVC', [i + 1]));
      end;
      Inc(i);
    end;
  end;

  recacc := (reccorr / Length(recdat)) * 100.0;
  Edit11.Text := Format('Accuracy %.2f%%', [recacc]);
  ListBox2.Items.Add(Format('Akurasi recall terhadap aturan region: %.2f%% (%d dari %d)', [recacc, reccorr, Length(recdat)]));
  ShowMessage('Proses klasifikasi recall selesai.');
end;

// Load model dari JSON
procedure TForm2.Button7Click(Sender: TObject);
var
  opndlg: TOpenDialog;
  jobj, jarch, jwts, jbias, jnorm: TJSONObject;
  jarr: TJSONArray;
  i: Integer;

  procedure loadw(const key: string; var w: TArray<TArray<Real>>);
  var
    a, r: TJSONArray;
    ii, jj: Integer;
  begin
    a := jwts.GetValue(key) as TJSONArray;
    for ii := 0 to High(w) do
    begin
      r := a.Items[ii] as TJSONArray;
      for jj := 0 to High(w[ii]) do
        w[ii, jj] := r.Items[jj].AsType<Real>;
    end;
  end;

  procedure loadb(const key: string; var b: TArray<Real>);
  var
    a: TJSONArray;
    ii: Integer;
  begin
    a := jbias.GetValue(key) as TJSONArray;
    for ii := 0 to High(b) do
      b[ii] := a.Items[ii].AsType<Real>;
  end;

begin
  opndlg := TOpenDialog.Create(Self);
  try
    opndlg.Filter := 'JSON Model File (*.json)|*.json';
    if not opndlg.Execute then Exit;
    ListBox1.Clear; ListBox3.Clear; ListBox4.Clear;
    ListBox5.Clear; ListBox6.Clear; ListBox7.Clear;

    jobj := TJSONObject.ParseJSONValue(TFile.ReadAllText(opndlg.FileName)) as TJSONObject;
    if jobj = nil then
    begin
      ShowMessage('Error: File JSON tidak valid.');
      Exit;
    end;
    try
      jarch := jobj.GetValue<TJSONObject>('architecture');
      nin := jarch.GetValue<Integer>('n_in');
      nh1 := jarch.GetValue<Integer>('n_hid1');
      nh2 := jarch.GetValue<Integer>('n_hid2');
      nh3 := jarch.GetValue<Integer>('n_hid3');
      nout := jarch.GetValue<Integer>('n_out');

      random;   // siapkan ukuran array bobot sesuai arsitektur
      jwts := jobj.GetValue<TJSONObject>('weights');
      loadw('w1', w1); loadw('w2', w2); loadw('w3', w3); loadw('w4', w4);
      jbias := jobj.GetValue<TJSONObject>('biases');
      loadb('b1', b1); loadb('b2', b2); loadb('b3', b3); loadb('b4', b4);

      if jobj.FindValue('normalization') <> nil then
      begin
        jnorm := jobj.GetValue<TJSONObject>('normalization');
        minrr := jnorm.GetValue<Real>('min_rr');
        maxrr := jnorm.GetValue<Real>('max_rr');
        minqrs := jnorm.GetValue<Real>('min_qrs');
        maxqrs := jnorm.GetValue<Real>('max_qrs');
      end;

      finepoch := jobj.GetValue<Integer>('final_epoch');
      curmse := jobj.GetValue<Real>('final_mse');
      finacc := jobj.GetValue<Real>('final_accuracy');
      lr := jobj.GetValue<Real>('learning_rate');
      mom := jobj.GetValue<Real>('momentum');

      jarr := jobj.GetValue('mse_history') as TJSONArray;
      SetLength(mseall, jarr.Count);
      for i := 0 to jarr.Count - 1 do
        mseall[i] := jarr.Items[i].AsType<Real>;

      Edit3.Text := IntToStr(nh1);
      Edit2.Text := IntToStr(nh2);
      Edit4.Text := IntToStr(nh3);
      Edit8.Text := FloatToStr(lr);
      Edit9.Text := FloatToStr(mom);

      Series2.Clear;
      Series2.Title := 'MSE per Epoch';
      Chart2.BottomAxis.Title.Caption := 'Epoch';
      for i := 0 to High(mseall) do Series2.AddXY(i + 1, mseall[i]);

      ListBox1.Items.Add('--- Model berhasil dimuat dari file ---');
      ListBox1.Items.Add(Format('Arsitektur: %d-%d-%d-%d-%d', [nin, nh1, nh2, nh3, nout]));
      ListBox1.Items.Add(Format('Training selesai pada epoch %d dengan MSE %.8f', [finepoch, curmse]));
      ListBox1.Items.Add(Format('Akurasi Tersimpan: %.2f%%', [finacc]));
      showw;
      ShowMessage('Model berhasil dimuat!');
    finally
      jobj.Free;
    end;
  finally
    opndlg.Free;
  end;
end;

// Ambil parameter dari form. Arsitektur: 2 input, 3 hidden layer, 7 output (region)
procedure TForm2.getdata;
var
  fs: TFormatSettings;
begin
  fs := TFormatSettings.Create;
  fs.DecimalSeparator := '.';
  try
    nin := 2;
    nout := 7;
    nh1 := StrToInt(Edit3.Text);
    nh2 := StrToInt(Edit2.Text);
    nh3 := StrToInt(Edit4.Text);
    lr := StrToFloat(Edit8.Text, fs);
    mom := StrToFloat(Edit9.Text, fs);
    errth := StrToFloat(Edit10.Text, fs);
  except
    on E: EConvertError do
    begin
      ShowMessage('Input tidak valid: ' + E.Message + '. Pastikan semua parameter terisi dengan angka.');
      Abort;
    end;
  end;
end;

// Bobot awal acak -0.5..0.5, bias 0
procedure TForm2.random;
var
  i, j: Integer;
begin
  System.Randomize;
  SetLength(w1, nin, nh1); SetLength(w2, nh1, nh2);
  SetLength(w3, nh2, nh3); SetLength(w4, nh3, nout);
  SetLength(b1, nh1); SetLength(b2, nh2);
  SetLength(b3, nh3); SetLength(b4, nout);
  for i := 0 to nin - 1 do for j := 0 to nh1 - 1 do w1[i, j] := System.Random - 0.5;
  for i := 0 to nh1 - 1 do for j := 0 to nh2 - 1 do w2[i, j] := System.Random - 0.5;
  for i := 0 to nh2 - 1 do for j := 0 to nh3 - 1 do w3[i, j] := System.Random - 0.5;
  for i := 0 to nh3 - 1 do for j := 0 to nout - 1 do w4[i, j] := System.Random - 0.5;
  for i := 0 to nh1 - 1 do b1[i] := 0.0;
  for i := 0 to nh2 - 1 do b2[i] := 0.0;
  for i := 0 to nh3 - 1 do b3[i] := 0.0;
  for i := 0 to nout - 1 do b4[i] := 0.0;
end;

procedure TForm2.showlayer(lb: TListBox; n: Integer; const w: TArray<TArray<Real>>; const b: TArray<Real>);
var
  k, j: Integer;
begin
  lb.Clear;
  lb.Items.Add(Format('--- Bobot w%d & Bias b%d ---', [n, n]));
  for k := 0 to High(w) do
    for j := 0 to High(w[k]) do
      lb.Items.Add(Format('w%d[%d, %d]: %.8f', [n, k, j, w[k, j]]));
  for j := 0 to High(b) do
    lb.Items.Add(Format('b%d[%d]: %.8f', [n, j, b[j]]));
end;

// Tampilkan bobot & bias semua layer
procedure TForm2.showw;
begin
  showlayer(ListBox3, 1, w1, b1);
  showlayer(ListBox4, 2, w2, b2);
  showlayer(ListBox5, 3, w3, b3);
  showlayer(ListBox6, 4, w4, b4);
end;

// Grafik riwayat bobot: satu garis per bobot
procedure TForm2.plotw(ch: TChart; const ttl: string;
  const hist: TArray<TArray<Real>>; nw: Integer);
var
  i, widx: Integer;
  lser: TLineSeries;
begin
  if not Assigned(ch) then Exit;
  ch.SeriesList.Clear;
  ch.Title.Text.Clear;
  ch.Title.Text.Add(ttl);
  ch.Legend.Visible := False;
  ch.BottomAxis.Title.Caption := 'Epoch';
  ch.LeftAxis.Title.Caption := 'Nilai Bobot';

  if Length(hist) = 0 then Exit;

  for widx := 0 to nw - 1 do
  begin
    lser := TLineSeries.Create(ch);
    lser.Marks.Visible := False;
    for i := 0 to High(hist) do
      if Length(hist[i]) > widx then
        lser.AddXY((i + 1) * epochstep, hist[i, widx]);
    ch.AddSeries(lser);
  end;
end;

procedure TForm2.updcharts;
begin
  plotw(Chart5, 'W1 History', w1hist, nin * nh1);
  plotw(Chart6, 'W2 History', w2hist, nh1 * nh2);
  plotw(Chart7, 'W3 History', w3hist, nh2 * nh3);
  plotw(Chart8, 'W4 History', w4hist, nh3 * nout);
end;

